#!/usr/bin/env bash
# Mock cortex binary for demo recording

CMD="$1"
SUBCMD="$2"

case "$CMD" in
  sync)
    echo "✔ Encryption passphrase: ●●●●●●●●●●●●●●"
    echo "Sync target: GitHub (alice/cortex-backup)"
    echo ""
    for i in 12 28 47; do
      printf "\r  Reading… %d files" "$i"
      sleep 0.15
    done
    printf "\r  47 files read                    \n"
    sleep 0.2
    echo ""
    echo "Diff — added: 47, modified: 0, removed: 0, unchanged: 0"
    for i in 10 22 35 47; do
      printf "\r  Uploading… %d/47 files" "$i"
      sleep 0.35
    done
    printf "\n"
    echo ""
    echo "✓ Sync complete — 47 uploaded, 0 deleted."
    ;;
  pull)
    echo "✔ Encryption passphrase: ●●●●●●●●●●●●●●"
    echo "Pull source: GitHub (alice/cortex-backup)"
    echo ""
    echo "Diff — to download: 47 (new: 47, changed: 0), to remove locally: 0"
    sleep 0.3
    echo "Remapping paths:"
    echo "  /Users/alice/myapp  →  /home/alice/work/myapp"
    echo "  /Users/alice/api    →  /home/alice/work/api"
    sleep 0.2
    for i in 12 26 40 47; do
      printf "\r  Downloading… %d/47 files" "$i"
      sleep 0.35
    done
    printf "\n"
    echo ""
    echo "✓ Pull complete — 47 files restored."
    ;;
  status)
    echo "Comparing local vs remote..."
    sleep 0.4
    echo ""
    echo "  2 files changed locally (not yet synced)"
    echo "  0 files changed remotely"
    echo ""
    echo "Run 'cortex sync' to upload."
    ;;
  setup-mcp)
    echo "Found cortex at: /home/alice/.local/bin/cortex"
    sleep 0.3
    echo "✔ Encryption passphrase: ●●●●●●●●●●●●●●"
    sleep 0.5
    echo ""
    echo "✓ cortex MCP server registered in Claude Code."
    echo "Restart Claude Code to activate it."
    ;;
  install)
    echo ""
    echo "Installing from https://github.com/acme/claude-config into $(pwd)/.claude/"
    sleep 0.4
    echo "  + .claude/skills/tdd.md"
    sleep 0.15
    echo "  + .claude/skills/code-review.md"
    sleep 0.15
    echo "  + .claude/CLAUDE.md"
    sleep 0.2
    echo "  Installing plugin: superpowers@claude-plugins-official"
    sleep 0.3
    echo "  ✔ Plugin installed"
    sleep 0.3
    echo "✔ Team passphrase (leave empty if sessions are not encrypted): ●●●●●●●●●●●●●●"
    sleep 0.6
    echo "  + 4 sessions installed"
    sleep 0.2
    echo ""
    echo "✓ Team context installed. Restart Claude Code to activate."
    ;;
  team)
    case "$SUBCMD" in
      init)
        echo ""
        echo "Cloning https://github.com/acme/claude-config → ~/.cortex/team/"
        sleep 0.5
        echo "  Copied 3 skills from .claude/skills/"
        sleep 0.2
        echo "  Copied .claude/CLAUDE.md"
        sleep 0.2
        echo "  Generated cortex.json (1 plugins)"
        sleep 0.4
        echo ""
        echo "⚠  Share chat sessions with the team?"
        echo "   Your Claude Code sessions will be visible to all team members."
        sleep 0.8
        echo "✔ Share sessions with the team? Yes"
        sleep 0.4
        echo "✔ Encrypt sessions? Yes — AES-256-GCM (recommended)"
        sleep 0.4
        echo "✔ Team passphrase (min 12 chars): ●●●●●●●●●●●●●●"
        sleep 0.8
        echo "  Uploaded 4 sessions"
        sleep 0.3
        echo ""
        echo "✓ Team repo initialized and pushed."
        echo "  Devs can now run: cortex install --repo https://github.com/acme/claude-config"
        ;;
      push)
        echo "Pulling latest from team repo…"
        sleep 0.4
        echo "✔ Team passphrase: ●●●●●●●●●●●●●●"
        sleep 0.5
        echo "  Uploaded 4 sessions"
        sleep 0.2
        echo ""
        echo "✓ Pushed to team repo."
        ;;
      pull)
        echo "Pulling from team repo…"
        sleep 0.4
        echo "  + tdd.md (new)"
        sleep 0.2
        echo "  + code-review.md (new)"
        sleep 0.2
        echo "  + CLAUDE.md (new)"
        sleep 0.3
        echo "✔ Team passphrase (to decrypt sessions): ●●●●●●●●●●●●●●"
        sleep 0.6
        echo "  + 4 sessions installed (restart Claude Code to see them)"
        sleep 0.2
        echo ""
        echo "✓ Team context applied."
        ;;
    esac
    ;;
  --version)
    echo "0.4.16"
    ;;
  *)
    echo "cortex — sync Claude Code sessions between machines"
    ;;
esac
